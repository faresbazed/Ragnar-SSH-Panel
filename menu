#!/bin/bash
# Ragnar SSH Panel - main menu
#
# Improvements over original:
#   - Fixed SC1087 bug: $d[crlf] was parsed as array subscript -> wrong output
#   - read -r everywhere (no backslash mangling)
#   - Better useradd failure detection (not just "exists")
#   - del_user without -r (users are created with -M, no home dir)
#   - svc_status shows per-service status with labels
#   - show_payload falls back gracefully if domain can't be parsed
#   - renew_cert uses plain renew (no --force-renewal rate-limit risk)
#   - restart_all does daemon-reload first
C='\033[0;36m'; G='\033[0;32m'; R='\033[0;31m'; Y='\033[0;33m'; N='\033[0m'

banner() {
  clear
  echo -e "${C}==============================================${N}"
  echo -e "${C}         R A G N A R   S S H   P A N E L${N}"
  echo -e "${C}==============================================${N}"
  echo -e "${C}  SSH-WS :80 | SSH-TLS :443 | UDP :7300 | DNS :53${N}"
  echo -e "${C}==============================================${N}"
}

add_user() {
  read -r -p "Username: " u
  [ -z "$u" ] && { echo -e "${R}Empty username${N}"; return; }
  read -r -sp "Password: " p; echo
  read -r -p "Days valid: " d
  [ -z "$d" ] && d=30
  if ! [[ "$d" =~ ^[0-9]+$ ]]; then
    echo -e "${R}Invalid number of days${N}"; return
  fi
  if id "$u" >/dev/null 2>&1; then
    echo -e "${R}User '$u' already exists${N}"; return
  fi
  if ! useradd -M -s /bin/false -e "$(date -d "+$d days" +%Y-%m-%d)" "$u" 2>/dev/null; then
    echo -e "${R}Failed to create user '$u' (invalid name?)${N}"; return
  fi
  echo "$u:$p" | chpasswd
  mkdir -p /etc/ragnar
  echo "$u $(date +%F) +${d}days" >> /etc/ragnar/users.log
  echo -e "${G}User $u created (expires in $d days)${N}"
}

del_user() {
  read -r -p "Username: " u
  [ -z "$u" ] && { echo -e "${R}Empty username${N}"; return; }
  if ! id "$u" >/dev/null 2>&1; then
    echo -e "${R}User '$u' not found${N}"; return
  fi
  # Users are created with -M (no home), so don't use -r
  userdel "$u" 2>/dev/null && echo -e "${G}Removed $u${N}" || echo -e "${R}Failed to remove $u${N}"
}

list_users() {
  echo -e "${C}Users (expiry):${N}"
  local found=0
  while IFS=: read -r _ _ uid _ _ _ shell _; do
    if [ "$uid" -ge 1000 ] 2>/dev/null && [[ "$shell" == *false* || "$shell" == *nologin* ]]; then
      # shellcheck disable=SC2312
      exp=$(chage -l "$(_get_username "$uid")" 2>/dev/null | awk -F': ' '/Account expires/{print $2}')
      echo "  $(_get_username "$uid")  ->  ${exp:-unknown}"
      found=1
    fi
  done < /etc/passwd
  [ "$found" -eq 0 ] && echo -e "  ${Y}(no panel users)${N}"
}

_get_username() {
  awk -F: -v uid="$1" '$3==uid{print $1; exit}' /etc/passwd
}

show_payload() {
  # Extract domain from stunnel config; fall back to hostname
  d=$(grep -m1 '^cert' /etc/stunnel/ssh-tls.conf 2>/dev/null | awk '{print $3}' | sed 's|.*live/||;s|/.*||')
  [ -z "$d" ] && d=$(hostname -f 2>/dev/null || hostname)
  echo -e "${G}--- WS PAYLOAD (port 80) ---${N}"
  # NOTE: [crlf] is literal text for the client, NOT a bash array subscript
  printf 'GET / HTTP/1.1[crlf]Host: %s[crlf]Upgrade: websocket[crlf]Connection: Keep-Alive[crlf][crlf]\n' "$d"
  echo -e "${G}--- SSL (port 443) ---${N}"
  echo "Server: $d  Port: 443  SNI: $d"
  echo -e "${G}--- DNS TUNNEL (53) ---${N}"
  echo "Zone: t.$d | Server: ns.$d | target: 127.0.0.1:22"
  echo -e "${G}--- UDP GW ---${N}"
  echo "badvpn-udpgw: 127.0.0.1:7300 (enable in tun2socks/HTTP Injector)"
}

svc_status() {
  echo -e "${C}--- services ---${N}"
  for svc in wsproxy stunnel4 badvpn-udpgw dnstt-server; do
    st=$(systemctl is-active "$svc" 2>/dev/null || echo "not-found")
    case "$st" in
      active)   printf "  %-18s ${G}%s${N}\n" "$svc" "$st" ;;
      inactive|failed) printf "  %-18s ${R}%s${N}\n" "$svc" "$st" ;;
      *) printf "  %-18s ${Y}%s${N}\n" "$svc" "$st" ;;
    esac
  done
  echo -e "${C}--- listening ---${N}"
  ss -tlnp 2>/dev/null | grep -E ':(80|443|22|7300)\b' || echo "  (no TCP listeners on panel ports)"
  ss -ulnp 2>/dev/null | grep ':53\b' || echo "  (no UDP listener on 53)"
}

restart_all() {
  systemctl daemon-reload
  systemctl restart wsproxy stunnel4 badvpn-udpgw dnstt-server 2>/dev/null \
    && echo -e "${G}All services restarted${N}" \
    || echo -e "${Y}Some services failed to restart (check: menu -> 5)${N}"
}

renew_cert() {
  echo -e "${Y}Running certbot renew...${N}"
  if certbot renew 2>/dev/null && systemctl restart stunnel4 2>/dev/null; then
    echo -e "${G}Cert renewed & stunnel restarted${N}"
  else
    echo -e "${R}Renew failed - run: certbot renew --dry-run${N}"
  fi
}

banner
while true; do
  echo "  1) Add user        4) Payloads"
  echo "  2) Delete user     5) Service status"
  echo "  3) List users      6) Restart all"
  echo "                      7) Renew cert"
  echo "                      0) Exit"
  read -r -p "  > " o
  case "$o" in
    1) add_user;; 2) del_user;; 3) list_users;;
    4) show_payload;; 5) svc_status;; 6) restart_all;;
    7) renew_cert;; 0) echo "Bye"; exit 0;;
    *) echo -e "${R}Invalid${N}";;
  esac
  echo; read -r -p "  [Enter] to continue..." _; banner
done
