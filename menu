# --- Colors ---
C='\033[0;36m'    # Cyan
G='\033[0;32m'    # Green
R='\033[0;31m'    # Red
Y='\033[0;33m'    # Yellow
W='\033[1;37m'    # White (bold)
P='\033[0;35m'    # Purple
D='\033[0;90m'    # Dark gray
N='\033[0m'       # Reset

# --- Branding ---
OWNER_TG="@farisbazed"
CHANNEL_TG="https://t.me/ragnaresim"

banner() {
  clear
  echo -e "${P}╔══════════════════════════════════════════════╗${N}"
  echo -e "${P}║${W}        R A G N A R   S S H   P A N E L        ${P}║${N}"
  echo -e "${P}╠══════════════════════════════════════════════╣${N}"
  if [ -f /etc/systemd/system/wsproxy.service.d/ragnar-xray.conf ]; then
    echo -e "${P}║${C}  SSH-WS :8080 | SSH-TLS :444 | Xray on    ${P}║${N}"
  else
    echo -e "${P}║${C}  SSH-WS :80 | SSH-TLS :443 | UDP :7300     ${P}║${N}"
  fi
  echo -e "${P}║${C}  DNS :53 | SSH :22                      ${P}║${N}"
  echo -e "${P}╠══════════════════════════════════════════════╣${N}"
  echo -e "${P}║${Y}  Owner : ${W}$OWNER_TG                       ${P}║${N}"
  echo -e "${P}║${Y}  TG    : ${W}t.me/ragnaresim                  ${P}║${N}"
  echo -e "${P}╚══════════════════════════════════════════════╝${N}"
  echo ""
}

get_domain() {
  d=$(grep -m1 '^\s*cert' /etc/stunnel/ssh-tls.conf 2>/dev/null | awk '{print $3}' | sed 's|.*live/||;s|/.*||')
  [ -z "$d" ] && d=$(hostname -f 2>/dev/null || hostname)
  echo "$d"
}

# ==========================================================
#   USER MANAGEMENT
# ==========================================================

add_user() {
  echo -e "${C}── Add User ──${N}"
  read -r -p "  Username: " u
  [ -z "$u" ] && { echo -e "${R}  Empty username${N}"; return; }
  read -r -sp "  Password: " p; echo
  [ -z "$p" ] && { echo -e "${R}  Empty password${N}"; return; }
  read -r -p "  Days valid (default 30): " d
  [ -z "$d" ] && d=30
  if ! [[ "$d" =~ ^[0-9]+$ ]]; then
    echo -e "${R}  Invalid number of days${N}"; return
  fi
  if id "$u" >/dev/null 2>&1; then
    echo -e "${R}  User '$u' already exists${N}"; return
  fi
  if ! useradd -M -s /bin/false -e "$(date -d "+$d days" +%Y-%m-%d)" "$u" 2>/dev/null; then
    echo -e "${R}  Failed to create user '$u' (invalid name?)${N}"; return
  fi
  HASH=$(openssl passwd -6 "$p")
  if ! usermod -p "$HASH" "$u" 2>/dev/null; then
    userdel "$u" 2>/dev/null
    echo -e "${R}  Failed to set password${N}"; return
  fi
  mkdir -p /etc/ragnar
  echo "$u $(date +%F) +${d}days" >> /etc/ragnar/users.log
  echo -e "${G}  ✓ User '$u' created (expires in $d days)${N}"
}

del_user() {
  echo -e "${C}── Delete User ──${N}"
  read -r -p "  Username: " u
  [ -z "$u" ] && { echo -e "${R}  Empty username${N}"; return; }
  if ! id "$u" >/dev/null 2>&1; then
    echo -e "${R}  User '$u' not found${N}"; return
  fi
  userdel "$u" 2>/dev/null && echo -e "${G}  ✓ Removed '$u'${N}" || echo -e "${R}  Failed to remove '$u'${N}"
}

list_users() {
  echo -e "${C}── Users ──${N}"
  echo -e "  ${D}Name                Expiry          Status${N}"
  echo -e "  ${D}─────────────────────────────────────────${N}"
  local found=0
  while IFS=: read -r _ _ uid _ _ _ shell _; do
    if [ "$uid" -ge 1000 ] 2>/dev/null && [[ "$shell" == *false* || "$shell" == *nologin* ]]; then
      # shellcheck disable=SC2094
      uname=$(awk -F: -v uid="$uid" '$3==uid{print $1; exit}' /etc/passwd)
      exp=$(chage -l "$uname" 2>/dev/null | awk -F': ' '/Account expires/{print $2}')
      # Check if expired
      if [ -n "$exp" ] && [ "$exp" != "never" ]; then
        if [ "$(date -d "$exp" +%s 2>/dev/null)" -lt "$(date +%s)" ]; then
          status="${R}expired${N}"
        else
          status="${G}active${N}"
        fi
      else
        status="${G}active${N}"
      fi
      printf "  ${W}%-18s${N} %-14s %b\n" "$uname" "${exp:-unknown}" "$status"
      found=1
    fi
  done < /etc/passwd
  [ "$found" -eq 0 ] && echo -e "  ${Y}(no panel users)${N}"
}

edit_user() {
  echo -e "${C}── Edit User ──${N}"
  read -r -p "  Username: " u
  [ -z "$u" ] && { echo -e "${R}  Empty username${N}"; return; }
  if ! id "$u" >/dev/null 2>&1; then
    echo -e "${R}  User '$u' not found${N}"; return
  fi
  echo -e "  ${Y}1${N}) Change password"
  echo -e "  ${Y}2${N}) Extend expiry"
  echo -e "  ${Y}3${N}) Lock account"
  echo -e "  ${Y}4${N}) Unlock account"
  echo -e "  ${Y}0${N}) Cancel"
  read -r -p "  > " choice
  case "$choice" in
    1)
      read -r -sp "  New password: " np; echo
      [ -z "$np" ] && { echo -e "${R}  Empty password${N}"; return; }
      HASH=$(openssl passwd -6 "$np")
      usermod -p "$HASH" "$u" 2>/dev/null && echo -e "${G}  ✓ Password changed for '$u'${N}" || echo -e "${R}  Failed${N}"
      ;;
    2)
      read -r -p "  Add days (default 30): " add
      [ -z "$add" ] && add=30
      if ! [[ "$add" =~ ^[0-9]+$ ]]; then
        echo -e "${R}  Invalid number${N}"; return
      fi
      # Get current expiry, add days
      cur_exp=$(chage -l "$u" 2>/dev/null | awk -F': ' '/Account expires/{print $2}')
      if [ -n "$cur_exp" ] && [ "$cur_exp" != "never" ]; then
        new_exp=$(date -d "$cur_exp + $add days" +%Y-%m-%d 2>/dev/null)
      else
        new_exp=$(date -d "+$add days" +%Y-%m-%d)
      fi
      chage -E "$new_exp" "$u" 2>/dev/null && echo -e "${G}  ✓ '$u' expiry extended to $new_exp${N}" || echo -e "${R}  Failed${N}"
      ;;
    3)
      usermod -L "$u" 2>/dev/null && echo -e "${G}  ✓ Account '$u' locked${N}" || echo -e "${R}  Failed${N}"
      ;;
    4)
      usermod -U "$u" 2>/dev/null && echo -e "${G}  ✓ Account '$u' unlocked${N}" || echo -e "${R}  Failed${N}"
      ;;
    0) return ;;
    *) echo -e "${R}  Invalid option${N}" ;;
  esac
}

svc_status() {
  echo -e "${C}── Service Status ──${N}"
  for svc in wsproxy stunnel4 badvpn-udpgw dnstt-server ragnar-xray ragnar-xray-expire.timer; do
    if ! systemctl cat "$svc" >/dev/null 2>&1; then
      printf "  ${D}%-16s not installed${N}\n" "$svc"
      continue
    fi
    st=$(systemctl is-active "$svc" 2>/dev/null || echo "unknown")
    case "$st" in
      active)   printf "  ${G}● %-16s %s${N}\n" "$svc" "$st" ;;
      inactive|failed) printf "  ${R}● %-16s %s${N}\n" "$svc" "$st" ;;
      *) printf "  ${Y}● %-16s %s${N}\n" "$svc" "$st" ;;
    esac
  done
}

server_stats() {
  echo -e "${C}── Server Stats ──${N}"
  # Uptime
  up=$(uptime -p 2>/dev/null || uptime 2>/dev/null | awk -F'load average: {print $1}')
  echo -e "  ${W}Uptime:${N} $up"
  # CPU
  cpu_load=$(awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null)
  echo -e "  ${W}Load:   ${N} $cpu_load"
  # Memory
  mem=$(free -h 2>/dev/null | awk '/^Mem:/{printf "%s / %s", $3, $2}')
  echo -e "  ${W}Memory: ${N} $mem"
  # Disk
  disk=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s / %s (%s)", $3, $2, $5}')
  echo -e "  ${W}Disk:   ${N} $disk"
  # IP
  ip_addr=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo -e "  ${W}IP:     ${N} $ip_addr"
  # Active SSH sessions
  ssh_sess=$(ss -tnp 2>/dev/null | grep ':22 ' | grep -c ESTAB 2>/dev/null || echo 0)
  echo -e "  ${W}SSH conns:${N} $ssh_sess"
}

restart_all() {
  echo -e "${Y}  Restarting services...${N}"
  systemctl daemon-reload
  local ok_count=0 fail_count=0
  for svc in wsproxy stunnel4 badvpn-udpgw dnstt-server ragnar-xray ragnar-xray-expire.timer; do
    if ! systemctl cat "$svc" >/dev/null 2>&1; then
      continue
    fi
    if systemctl restart "$svc" 2>/dev/null; then
      ok_count=$((ok_count+1))
    else
      fail_count=$((fail_count+1))
      echo -e "  ${R}✗ $svc failed${N}"
    fi
  done
  if [ "$fail_count" -eq 0 ]; then
    echo -e "${G}  ✓ All services restarted ($ok_count)${N}"
  else
    echo -e "${Y}  $ok_count restarted, $fail_count failed${N}"
  fi
}

renew_cert() {
  echo -e "${Y}  Running certbot renew...${N}"
  if certbot renew && systemctl restart stunnel4; then
    echo -e "${G}  Certificate renewal checked; service hooks applied.${N}"
  else
    echo -e "${R}  ✗ Renew failed - run: certbot renew --dry-run${N}"
  fi
}

uninstall() {
  echo -e "${R}  WARNING: This will remove Ragnar SSH Panel!${N}"
  read -r -p "  Type 'yes' to confirm: " confirm
  [ "$confirm" != "yes" ] && { echo -e "${Y}  Cancelled${N}"; return; }
  systemctl disable --now ragnar-xray-expire.timer 2>/dev/null
  systemctl stop ragnar-xray-expire.service ragnar-xray.service 2>/dev/null
  systemctl disable ragnar-xray.service 2>/dev/null
  rm -f /etc/systemd/system/ragnar-xray{,-expire}.service /etc/systemd/system/ragnar-xray-expire.timer
  rm -f /etc/systemd/system/wsproxy.service.d/ragnar-xray.conf
  rm -f /etc/letsencrypt/renewal-hooks/{pre,post}/ragnar-xray.sh
  rm -f /etc/letsencrypt/renewal-hooks/deploy/ragnar-restart.sh
  rm -rf /run/ragnar-cert-renew /usr/local/lib/ragnar-xray
  rm -f /usr/local/bin/ragnar-xray
  systemctl stop wsproxy stunnel4 badvpn-udpgw dnstt-server 2>/dev/null
  systemctl disable wsproxy stunnel4 badvpn-udpgw dnstt-server 2>/dev/null
  rm -f /etc/systemd/system/{wsproxy,badvpn-udpgw,dnstt-server,ragnar-iptables}.service
  rm -f /usr/local/bin/{wsproxy.py,menu,ragnar,badvpn-udpgw,dnstt-server}
  rm -rf /opt/ragnar /etc/ragnar
  systemctl daemon-reload
  echo -e "${G}  ✓ Panel removed. (stunnel4, certbot, ufw left installed)${N}"
}

# ==========================================================
#   DNSTT - DNS TUNNEL MANAGEMENT
# ==========================================================

dnstt_menu() {
  echo -e "${C}── DNS Tunnel (dnstt) ──${N}"
  if [ -x /usr/local/bin/dnstt-server ]; then
    echo -e "  ${G}✓ dnstt-server is installed${N}"
  else
    echo -e "  ${R}✗ dnstt-server is NOT installed${N}"
  fi
  if systemctl cat dnstt-server >/dev/null 2>&1; then
    st=$(systemctl is-active dnstt-server 2>/dev/null)
    echo -e "  Service: ${W}$st${N}"
  else
    echo -e "  Service: ${D}not configured${N}"
  fi
  echo ""
  echo -e "  ${Y}1${N}) Install dnstt-server"
  echo -e "  ${Y}2${N}) Configure & start service"
  echo -e "  ${Y}3${N}) Show DNS records / public key"
  echo -e "  ${Y}4${N}) Restart dnstt service"
  echo -e "  ${Y}5${N}) Stop dnstt service"
  echo -e "  ${Y}0${N}) Back"
  read -r -p "  > " dc
  case "$dc" in
    1) dnstt_install;;
    2) dnstt_configure;;
    3) dnstt_info;;
    4) systemctl restart dnstt-server 2>/dev/null && echo -e "${G}  ✓ dnstt restarted${N}" || echo -e "${R}  Failed (not configured?)${N}";;
    5) systemctl stop dnstt-server 2>/dev/null && echo -e "${G}  ✓ dnstt stopped${N}" || echo -e "${R}  Failed${N}";;
    0) return;;
    *) echo -e "${R}  Invalid option${N}";;
  esac
}

dnstt_install() {
  echo -e "${Y}  Installing dnstt-server (may take a few minutes)...${N}"

  # --- Method 1: Try prebuilt binary (fast, no Go needed) ---
  ARCH=$(uname -m)
  case "$ARCH" in
    x86_64)  PB_URL="https://github.com/Mygod/dnstt/releases/download/v20260501/dnstt-server-linux-amd64" ;;
    aarch64) PB_URL="https://github.com/Mygod/dnstt/releases/download/v20260501/dnstt-server-linux-arm64" ;;
    *) PB_URL="" ;;
  esac
  if [ -n "$PB_URL" ]; then
    echo -e "${C}  Trying prebuilt binary ($ARCH)...${N}"
    if wget -qO /usr/local/bin/dnstt-server "$PB_URL" 2>/dev/null && [ -s /usr/local/bin/dnstt-server ]; then
      if [ "$(head -c4 /usr/local/bin/dnstt-server 2>/dev/null)" = "$(printf '\177ELF')" ]; then
        chmod +x /usr/local/bin/dnstt-server
        echo -e "${G}  ✓ dnstt-server installed (prebuilt binary)${N}"
        return
      fi
      rm -f /usr/local/bin/dnstt-server
    fi
    echo -e "${Y}  Prebuilt binary unavailable, falling back to build from source...${N}"
  fi

  # --- Method 2: Build from source ---
  # Install Go if not present
  if ! command -v go >/dev/null 2>&1; then
    echo -e "${C}  Installing golang-go...${N}"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y golang-go >/dev/null 2>&1 || { echo -e "${R}  Failed to install golang-go${N}"; return; }
  fi
  echo -e "  Go version: $(go version 2>/dev/null || echo unknown)"
  # Clone and build
  rm -rf /tmp/dnstt /tmp/dnstt.zip
  echo -e "${C}  Downloading dnstt source...${N}"
  if git clone --depth 1 https://github.com/Mygod/dnstt.git /tmp/dnstt 2>&1; then
    :
  elif wget -qO /tmp/dnstt.zip https://www.bamsoftware.com/software/dnstt/dnstt-20260501.zip 2>/dev/null; then
    ( cd /tmp && unzip -qo dnstt.zip && mv /tmp/dnstt-* /tmp/dnstt ) 2>/dev/null
  else
    echo -e "${R}  Download failed${N}"; return
  fi
  if [ ! -d /tmp/dnstt ]; then
    echo -e "${R}  Source not found after download${N}"; return
  fi
  echo -e "${C}  Building dnstt-server (this may take 1-2 min)...${N}"
  echo -e "  (output shown below for debugging)"
  echo -e "  ${D}──────────────────────────────────────────${N}"
  # Use -o to specify output name because "dnstt-server" is also a source dir
  if ( cd /tmp/dnstt && go build -v -o /tmp/dnstt-server-bin ./dnstt-server 2>&1 ); then
    echo -e "  ${D}──────────────────────────────────────────${N}"
    if [ -f /tmp/dnstt-server-bin ]; then
      install -m 755 /tmp/dnstt-server-bin /usr/local/bin/dnstt-server
      rm -rf /tmp/dnstt /tmp/dnstt.zip /tmp/dnstt-server-bin
      echo -e "${G}  ✓ dnstt-server installed (built from source)${N}"
    else
      echo -e "  ${D}──────────────────────────────────────────${N}"
      echo -e "${R}  Build succeeded but binary not found${N}"
    fi
  else
    echo -e "  ${D}──────────────────────────────────────────${N}"
    echo -e "${R}  Build failed${N}"
    echo -e "${Y}  You can try building manually:${N}"
    echo -e "  ${W}cd /tmp/dnstt && go build -o /tmp/dnstt-server-bin ./dnstt-server${N}"
  fi
}

dnstt_configure() {
  if [ ! -x /usr/local/bin/dnstt-server ]; then
    echo -e "${R}  dnstt-server not installed. Use option 1 first.${N}"; return
  fi
  d=$(get_domain)
  echo -e "  Domain detected: ${W}$d${N}"
  read -r -p "  Use this domain for DNS tunnel? [Y/n]: " use_d
  if [[ "$use_d" =~ ^[Nn] ]]; then
    read -r -p "  Enter domain for dnstt: " d
    [ -z "$d" ] && { echo -e "${R}  Domain required${N}"; return; }
  fi
  # Generate keys if not present
  mkdir -p /etc/dnstt
  if [ ! -f /etc/dnstt/server.key ]; then
    echo -e "${C}  Generating dnstt keys...${N}"
    /usr/local/bin/dnstt-server -gen-key -privkey-file /etc/dnstt/server.key -pubkey-file /etc/dnstt/server.pub \
      || { echo -e "${R}  Key generation failed${N}"; return; }
    echo -e "${G}  ✓ Keys generated${N}"
  fi
  # Create systemd service
  cat > /etc/systemd/system/dnstt-server.service <<EOF
[Unit]
Description=dnstt DNS Tunnel (53/udp)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnstt-server -udp :5300 -privkey-file /etc/dnstt/server.key t.$d 127.0.0.1:22
Restart=always

[Install]
WantedBy=multi-user.target
EOF
  # iptables redirect 53 -> 5300
  iptables -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null || \
    iptables -t nat -A PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300
  # Persist iptables rule via systemd unit (works on Ubuntu 24.04 without iptables-persistent)
  cat > /etc/systemd/system/ragnar-iptables.service <<'EOF'
[Unit]
Description=Ragnar SSH Panel - iptables DNAT rule for dnstt (53->5300)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/iptables -t nat -A PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300
ExecStop=/sbin/iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable dnstt-server ragnar-iptables >/dev/null 2>&1
  systemctl start ragnar-iptables 2>/dev/null
  systemctl restart dnstt-server 2>/dev/null
  if systemctl is-active dnstt-server >/dev/null 2>&1; then
    echo -e "${G}  ✓ dnstt configured and running on port 53${N}"
  else
    echo -e "${R}  dnstt service failed to start${N}"
    echo -e "${Y}  Check: journalctl -xeu dnstt-server${N}"
  fi
}

dnstt_info() {
  if [ ! -x /usr/local/bin/dnstt-server ]; then
    echo -e "${R}  dnstt-server not installed${N}"; return
  fi
  d=$(get_domain)
  echo ""
  echo -e "${G}╔═══ DNS Tunnel Info ════════════════════════╗${N}"
  echo -e "${W}  DNS Zone : t.$d${N}"
  echo -e "${W}  NS Server: ns.$d${N}"
  echo -e "${W}  Target  : 127.0.0.1:22 (SSH)${N}"
  echo -e "${G}╚══════════════════════════════════════════╝${N}"
  if [ -f /etc/dnstt/server.pub ]; then
    echo ""
    echo -e "${C}  Public key (share with clients):${N}"
    echo -e "${Y}  $(cat /etc/dnstt/server.pub)${N}"
  fi
  echo ""
  echo -e "${C}  Required DNS records:${N}"
  echo -e "  ${W}A${N}   ns.$d     -> <your VPS IP>"
  echo -e "  ${W}NS${N}  t.$d      -> ns.$d"
  echo ""
  echo -e "${C}  Client setup:${N}"
  echo -e "  ${W}dnstt-client -pubkey-file server.pub t.$d 127.0.0.1:1080${N}"
}

# ==========================================================
#   XRAY - VLESS / VMESS / TROJAN
# ==========================================================

xray_menu() {
  local choice name protocol transport port expires path tls setup
  local -a options
  [ "$(id -u)" -eq 0 ] || { echo "Run menu as root for Xray management."; return; }
  while true; do
    echo ""
    echo "  Xray: VLESS / VMess / Trojan (WS + TCP)"
    echo "  1) Install Xray (moves SSH to WS 8080 / TLS 444)"
    echo "  2) Add user          3) List users"
    echo "  4) Copy URIs         5) Set expiration date"
    echo "  6) Disable user      7) Enable user"
    echo "  8) Delete user       9) List listeners"
    echo "  10) Add listener    11) Delete listener"
    echo "  12) Reconcile expiry now"
    echo "  0) Back"
    echo "  Dates: valid THROUGH selected date (UTC); expiry checked every 30s."
    echo "  Changes/expiry restart Xray and disconnect all Xray sessions."
    read -r -p "  > " choice || return
    [ "$choice" != 0 ] || return
    if [ "$choice" = 1 ]; then
      setup=/opt/ragnar/install-xray.sh
      [ -f "$setup" ] || setup="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/install-xray.sh"
      if [ -f "$setup" ]; then
        bash "$setup"
      else
        echo "Update the full Ragnar checkout first; install-xray.sh is missing."
      fi
      continue
    fi
    if [ ! -x /usr/local/bin/ragnar-xray ] || [ ! -f /etc/ragnar/xray/state.json ]; then
      echo "Install/configure Xray using option 1 first."
      continue
    fi
    case "$choice" in
      2)
        read -r -p "  Username: " name
        read -r -p "  Protocol [vless/vmess/trojan, default vless]: " protocol
        protocol=${protocol:-vless}
        read -r -p "  Valid through (YYYY-MM-DD, UTC): " expires
        /usr/local/bin/ragnar-xray add-user --expires "$expires" -- "$name" "$protocol"
        ;;
      3) /usr/local/bin/ragnar-xray users ;;
      4|5|6|7|8)
        read -r -p "  Username: " name
        case "$choice" in
          4) /usr/local/bin/ragnar-xray uri -- "$name" ;;
          5)
            read -r -p "  New valid-through date (YYYY-MM-DD, UTC): " expires
            /usr/local/bin/ragnar-xray renew-user --expires "$expires" -- "$name"
            ;;
          6) /usr/local/bin/ragnar-xray disable-user -- "$name" ;;
          7) /usr/local/bin/ragnar-xray enable-user -- "$name" ;;
          8)
            read -r -p "  Permanently delete this Xray user? [yes/no]: " tls
            [ "$tls" != yes ] || /usr/local/bin/ragnar-xray delete-user -- "$name"
            ;;
        esac
        ;;
      9) /usr/local/bin/ragnar-xray listeners ;;
      10)
        echo "  One listener per port. 80 = non-TLS; 443/8443/2053 = TLS."
        echo "  WS can use Cloudflare on supported ports; TCP needs direct/DNS-only access."
        echo "  Trojan must use TLS. Non-TLS VLESS traffic is not encrypted."
        read -r -p "  Protocol [vless/vmess/trojan]: " protocol
        read -r -p "  Transport [ws/tcp]: " transport
        read -r -p "  Free port: " port
        read -r -p "  Enable TLS? [Y/n]: " tls
        options=()
        [[ "$tls" =~ ^[Nn] ]] || options+=(--tls)
        if [ "$transport" = ws ]; then
          read -r -p "  WS path [/$protocol]: " path
          options+=(--path "${path:-/$protocol}")
        fi
        /usr/local/bin/ragnar-xray add-listener "${options[@]}" -- "$protocol" "$transport" "$port"
        ;;
      11)
        /usr/local/bin/ragnar-xray listeners
        read -r -p "  Listener ID to delete: " name
        read -r -p "  Disconnect this listener's clients? [yes/no]: " tls
        [ "$tls" != yes ] || /usr/local/bin/ragnar-xray delete-listener -- "$name"
        ;;
      12) /usr/local/bin/ragnar-xray sync ;;
      *) echo "  Invalid option." ;;
    esac
  done
}

