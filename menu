G='\033[0;32m'    # Green
R='\033[0;31m'    # Red
Y='\033[0;33m'    # Yellow
W='\033[1;37m'    # White (bold)
P='\033[0;35m'    # Purple
D='\033[0;90m'    # Dark gray
N='\033[0m'       # Reset

# --- Branding ---
