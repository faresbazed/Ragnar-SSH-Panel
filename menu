banner
while true; do
  echo -e "  ${C}━━━ User Management ━━━━━━━━━━━━━━━━━━${N}"
  echo -e "  ${G}1${N}) Add user          ${G}4${N}) Edit user"
  echo -e "  ${G}2${N}) Delete user       ${G}3${N}) List users"
  echo -e "  ${C}━━━ Panel & Server ━━━━━━━━━━━━━━━━━${N}"
  echo -e "  ${G}5${N}) Service status    ${G}6${N}) Restart all"
  echo -e "  ${G}7${N}) Server stats      ${G}8${N}) Renew cert"
  echo -e "  ${G}9${N}) DNS Tunnel (dnstt)${G}10${N}) Uninstall"
  echo -e "  ${G}11${N}) Xray (VLESS / VMess / Trojan)"
  echo -e "  ${G}12${N}) Switch SSH / Xray on ports 80 and 443"
  echo -e "  ${C}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
  echo -e "  ${R}0${N}) Exit"
  echo ""
  read -r -p "  > " o
  case "$o" in
    1) add_user;; 2) del_user;; 3) list_users;; 4) edit_user;;
    5) svc_status;; 6) restart_all;; 7) server_stats;; 8) renew_cert;;
    9) dnstt_menu;; 10) uninstall;; 11) xray_menu;; 12) port_menu;;
    0) echo -e "${P}  Bye! - $OWNER_TG | $CHANNEL_TG${N}"; exit 0;;
    *) echo -e "${R}  Invalid option${N}";;
  esac
  echo ""
  read -r -p "  [Enter] to continue..." _
  banner
done
